# Copy to .env for local overrides. Never commit .env.
# Placeholders only. Docker Compose sets its own local database URL.

# PostgreSQL URL used by the API and Alembic when you are not using Compose.
# Unit tests do not need this; they use SQLite.
SENTINEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sentinel

# stdlib log level. This is not a tracing system.
SENTINEL_LOG_LEVEL=INFO

# Reserved. When true, ``build_registry`` uses mock IP and hash providers.
# It does not start an investigation, and a failed live lookup is not replaced
# with a mock. CVE, MITRE, and DNS ignore this flag.
SENTINEL_DEMO_MODE=false

# LLM provider. Not called in this release. Leave blank.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=

# AbuseIPDB v2. lookup_ip calls the API only when this is set and demo_mode is false.
# A missing key is a configuration error, not a clean verdict.
SENTINEL_ABUSEIPDB_API_KEY=

# VirusTotal API v3. lookup_hash calls the API only when this is set and demo_mode is false.
SENTINEL_VIRUSTOTAL_API_KEY=

# Per-call timeout for provider HTTP and DNS. Lookups are not retried.
SENTINEL_PROVIDER_TIMEOUT_SECONDS=5

# Budgets the future executor must honor. Transition helpers read these.
SENTINEL_MAX_TOOL_CALLS=8
SENTINEL_MAX_RETRIES=2
SENTINEL_MAX_REPAIR_ATTEMPTS=1
SENTINEL_INVESTIGATION_TIMEOUT_SECONDS=120
SENTINEL_TOKEN_BUDGET=24000
