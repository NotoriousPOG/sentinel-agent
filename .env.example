# Copy to .env for local overrides. Never commit .env.
# Placeholders only. Docker Compose sets its own local database URL.

# PostgreSQL URL used by the API and Alembic when you are not using Compose.
# Unit tests do not need this; they use SQLite.
SENTINEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sentinel

# stdlib log level. Tracing is separate. See SENTINEL_OTEL_EXPORTER.
SENTINEL_LOG_LEVEL=INFO

# When true, IP and hash tools use mock providers, and POST /investigations
# uses the in-process scripted demo model. No LLM base URL, key, or model is
# required. A failed live lookup is not replaced with a mock. CVE, MITRE, and
# DNS ignore this flag. When false, a missing LLM setting is a configuration
# error and the investigation is not stored.
SENTINEL_DEMO_MODE=false

# OpenAI-compatible chat completions (POST {base}/chat/completions).
# Used by POST /investigations only when demo_mode is false. A missing value
# is then a configuration error. The key is not logged. Tests do not call
# this endpoint. The scripted demo model does not use these variables.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=

# AbuseIPDB v2. lookup_ip calls the API only when this is set and demo_mode is false.
# A missing key is a configuration error, not a clean verdict.
SENTINEL_ABUSEIPDB_API_KEY=

# VirusTotal API v3. lookup_hash calls the API only when this is set and demo_mode is false.
SENTINEL_VIRUSTOTAL_API_KEY=

# Per-call timeout for provider HTTP and DNS. Lookups are not retried.
SENTINEL_PROVIDER_TIMEOUT_SECONDS=5

# Budgets the executor must honor. Transition helpers read these.
SENTINEL_MAX_TOOL_CALLS=8
SENTINEL_MAX_RETRIES=2
SENTINEL_MAX_REPAIR_ATTEMPTS=1
SENTINEL_INVESTIGATION_TIMEOUT_SECONDS=120
SENTINEL_TOKEN_BUDGET=24000

# Trace exporter. Read at process start.
# off: no exporter. Nothing is printed and nothing is contacted.
# console: spans are written to this process's stdout. No collector is running.
# otlp is not accepted. This build cannot send spans anywhere.
SENTINEL_OTEL_EXPORTER=off

# USD per million recorded tokens. Leave this unset.
# Unset means estimated_cost_usd is 0. This is not a price for any model.
# A number here is one you supply. Sentinel does not look up a vendor rate.
SENTINEL_USD_PER_MILLION_TOKENS=

# Provider raw at DEBUG only, and only if a caller uses the debug helper.
# Info never logs raw. Provider clients do not call the helper. Leave this false.
SENTINEL_LOG_PROVIDER_RAW=false
